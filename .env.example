# Public site URL — read by lib/site.ts. No trailing slash.
# Falls back to https://4kspaintv.com when unset.
NEXT_PUBLIC_SITE_URL=https://4kspaintv.com

# ─── TMDB (server-side only — do NOT prefix with NEXT_PUBLIC_) ───────
# Read only in lib/tmdb/*. Requests use Authorization: Bearer <TMDB_ACCESS_TOKEN>.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# ─── Football data (server-side only — do NOT prefix with NEXT_PUBLIC_) ─
# API-Football — header x-apisports-key. Read only in lib/football/*.
FOOTBALL_API_KEY=
# Optional: pin the season for standings (e.g. 2024). Auto-detected if empty.
FOOTBALL_SEASON=
# TheSportsDB — used for league badges. Public test key '3' is used if empty.
THESPORTSDB_API_KEY=
